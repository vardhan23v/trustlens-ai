GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
FACTCHECK_API_KEY=
MAX_UPLOAD_MB=10
DEBUG=false
CREWAI_DISABLE_TELEMETRY=true
OTEL_SDK_DISABLED=true
# Optional: PDF report wording via a FREE OpenRouter model (id must end with :free). Leave empty to
# build the PDF directly from the TrustLens analysis.
OPENROUTER_API_KEY=
OPENROUTER_REPORT_MODEL=

# Optional: PostgreSQL for stored reports (Railway sets this from the Postgres service)
DATABASE_URL=

# Models tried in order when the current one runs out of quota (comma separated; empty to disable)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
